    {
      "key": "accent",
      "type": "list",
      "label": "Accent",
      "help": "The one colour on the panel",
      "default": "red",
      "options": [
        {
          "value": "red",
          "label": "Red"
        },
        {
          "value": "orange",
          "label": "Orange"
        },
        {
          "value": "yellow",
