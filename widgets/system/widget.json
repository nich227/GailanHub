{
  "name": "system",
  "title": "System Monitor",
  "description": "Memory, processor, disk or network, on a scale you can read a value off",
  "author": "Kevin Chen",
  "license": "MIT",
  "version": "1.0.0",
  "entry": "index.tsx",
  "tags": [
    "system"
  ],
  "minimumGailanVersion": "1.0.0",
  "screenshotOutput": "ram 42",
  "settings": [
    {
      "key": "source",
      "type": "list",
      "label": "Metric to monitor",
      "help": "What the panel watches",
      "default": "ram",
      "options": [
        {
          "value": "ram",
          "label": "RAM Usage"
        },
        {
          "value": "cpu",
          "label": "CPU Usage"
        },
        {
          "value": "disk",
          "label": "Disk Usage"
        },
        {
          "value": "network",
          "label": "Network Usage"
        }
      ]
    },
    {
      "key": "interval",
      "type": "list",
      "label": "Update every",
      "help": "How often the reading is taken. A processor reading costs a second of sampling, so it cannot go faster than that.",
      "default": "5",
      "options": [
        {
          "value": "1",
          "label": "1 second"
        },
        {
          "value": "2",
          "label": "2 seconds"
        },
        {
          "value": "5",
          "label": "5 seconds"
        },
        {
          "value": "10",
          "label": "10 seconds"
        },
        {
          "value": "30",
          "label": "30 seconds"
        },
        {
          "value": "60",
          "label": "1 minute"
        }
      ]
    },
    {
      "key": "background",
      "type": "list",
      "label": "Background",
      "help": "Follow the system, or hold one of these whatever the system does",
      "default": "follow",
      "options": [
        {
          "value": "follow",
          "label": "Follow system"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "pink",
          "label": "Pink"
        }
      ]
    },
    {
      "key": "draggable",
      "type": "toggle",
      "label": "Drag to move",
      "help": "Hold and drag the widget to place it. Needs interaction turned on in Gailan.",
      "default": false
    }
  ]
}
